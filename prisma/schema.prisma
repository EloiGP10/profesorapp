generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["profesorapp"]
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  passwordHash  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  groups        Group[]
  reminders     Reminder[]
  appAccesses   AppAccess[]
  auditLogs     AuditLog[]
  userAppAccess UserAppAccess?
  authoredNotes StudentNote[]

  @@index([email])
  @@index([createdAt])
  @@schema("profesorapp")
}

model Group {
  id              String      @id @default(cuid())
  name            String
  code            String?
  year            Int         @default(2026)
  penaltyAbsence  Float       @default(0)
  penaltyLate     Float       @default(0)
  penaltyNegative Float       @default(0)
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  students        Student[]
  trimesters      Trimester[]
  reminders       Reminder[]
  enrollments     Enrollment[]
  appAccesses     AppAccess[]
  auditLogs       AuditLog[]

  // FASE 0: Jerarquía académica (foreign keys opcionales para compatibilidad)
  academicYearId  String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id], onDelete: SetNull)
  educationId     String?
  education       Education?    @relation(fields: [educationId], references: [id], onDelete: SetNull)
  courseId         String?
  course           Course?       @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([academicYearId])
  @@index([educationId])
  @@index([courseId])
  @@index([year])
  @@index([createdAt])
  @@schema("profesorapp")
}

model Student {
  id                String        @id @default(cuid())
  groupId           String
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  listNumber        Int

  // Campos actuales (se mantienen para compatibilidad)
  name              String
  surname1          String
  surname2          String?
  nia               String?
  email             String?
  phone             String?

  // FASE 1: Identidad ITACA-compatible
  firstName         String?       // nombre real (migrado desde name)
  lastName1         String?       // primer apellido (migrado desde surname1)
  lastName2         String?       // segundo apellido (migrado desde surname2)
  itacaId           String?       // ID de ITACA
  status            String        @default("ACTIVE") // ACTIVE | INACTIVE | TRANSFERRED
  dateOfBirth       DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  grades            Grade[]
  absences          Absence[]
  exceptions        Exception[]
  rubricScores      RubricScore[]
  notes             StudentNote[]
  customAssessments Assessment[]  @relation("StudentCustomAssessments")
  enrollments       Enrollment[]
  contentEnrollments StudentContentEnrollment[]
  gradeObservations GradeObservation[]
  evaluationObservations EvaluationObservation[]
  qualifications Qualification[]
  targetGrades  TargetGrade[]
  reminders     Reminder[]
  acImprentas   ACImprenta[]
  exigibles     Exigible[]

  @@unique([groupId, listNumber])
  @@index([groupId])
  @@index([itacaId])
  @@index([nia])
  @@index([name])
  @@index([surname1])
  @@index([status])
  @@index([createdAt])
  @@schema("profesorapp")
}

model Trimester {
  id           String       @id @default(cuid())
  groupId      String
  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name         String       @default("Trimestre 1")
  percentage   Int          @default(34)
  order        Int          @default(1)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  assessments  Assessment[]
  absences     Absence[]

  @@index([groupId])
  @@schema("profesorapp")
}

model Assessment {
  id          String       @id @default(cuid())
  trimesterId String
  trimester   Trimester    @relation(fields: [trimesterId], references: [id], onDelete: Cascade)
  studentId   String?
  student     Student?     @relation("StudentCustomAssessments", fields: [studentId], references: [id], onDelete: Cascade)
  name        String
  type        String       @default("EXAM") // EXAM | NOTEBOOK | WORK | RUBRIC_WORK | OTHER
  percentage  Float        @default(10)
  maxScore    Float        @default(10)
  isExtra     Boolean      @default(false)
  order       Int          @default(1)
  columnColor String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  grades      Grade[]
  rubric      Rubric?
  exceptions  Exception[]

  @@index([trimesterId])
  @@index([studentId])
  @@schema("profesorapp")
}

model Grade {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  score        Float?

  // FASE 2: Campos enriquecidos (opcionales, coexisten con score)
  activityId       String?
  activity         Activity?  @relation(fields: [activityId], references: [id], onDelete: SetNull)
  contentId        String?
  content          TeachingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  evaluationId     String?
  evaluation       Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  numericValue     Float?     // nota numérica (mantiene precisión)
  qualitativeValue String?    // valor cualitativo
  rawValue         Float?     // valor sin procesar
  status           String     @default("NORMAL") // NORMAL | EXEMPT | ADAPTED | PASSED_PREVIOUSLY | OTHER
  source           String     @default("MANUAL") // MANUAL | CALCULATED | RUBRIC | IMPORTED

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  gradeObservations GradeObservation[]

  @@unique([studentId, assessmentId])
  @@index([assessmentId])
  @@index([studentId])
  @@index([activityId])
  @@index([contentId])
  @@index([evaluationId])
  @@index([status])
  @@index([numericValue])
  @@index([createdAt])
  @@schema("profesorapp")
}

model Rubric {
  id           String         @id @default(cuid())
  assessmentId String         @unique
  assessment   Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  activityId   String?        @unique // FASE 2: conexión con Activity
  activity     Activity?      @relation(fields: [activityId], references: [id], onDelete: SetNull)
  rows         RubricRow[]

  @@index([assessmentId])
  @@schema("profesorapp")
}

model RubricRow {
  id             String       @id @default(cuid())
  rubricId       String
  rubric         Rubric       @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  title          String
  percentage     Float        @default(25)
  order          Int          @default(1)
  poorText       String       @default("Mal")
  fairText       String       @default("Regular")
  goodText       String       @default("Bien")
  excellentText  String       @default("Genial")
  scores         RubricScore[]

  @@index([rubricId])
  @@schema("profesorapp")
}

model RubricScore {
  id          String     @id @default(cuid())
  rubricRowId String
  rubricRow   RubricRow  @relation(fields: [rubricRowId], references: [id], onDelete: Cascade)
  studentId   String
  student     Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  level       String     @default("POOR") // POOR | FAIR | GOOD | EXCELLENT

  @@unique([rubricRowId, studentId])
  @@index([studentId])
  @@schema("profesorapp")
}

model Exception {
  id           String     @id @default(cuid())
  studentId    String
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  isExcluded   Boolean    @default(true)
  notes        String?
  createdAt    DateTime   @default(now())

  @@unique([studentId, assessmentId])
  @@index([assessmentId])
  @@index([studentId])
  @@schema("profesorapp")
}

model Absence {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trimesterId String?
  trimester   Trimester? @relation(fields: [trimesterId], references: [id], onDelete: SetNull)
  date        DateTime  @default(now())
  type        String    @default("ABSENT") // ABSENT | LATE | NEGATIVE | JUSTIFIED | EXEMPT
  notes       String?
  justified   Boolean   @default(false)
  penalty     Float     @default(0) // penalización aplicada
  evaluationId String?
  evaluation  Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  contentId   String?
  content     TeachingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  source      String    @default("MANUAL") // MANUAL | IMPORTED | ITACA
  itacaId     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([studentId])
  @@index([trimesterId])
  @@index([date])
  @@index([type])
  @@index([evaluationId])
  @@index([contentId])
  @@index([itacaId])
  @@schema("profesorapp")
}

model StudentNote {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  content     String
  category    String?  // ACADEMIC | BEHAVIOR | PERSONAL | OTHER
  isImportant Boolean  @default(false)
  isPrivate   Boolean  @default(false)
  authorId    String?
  author      User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  evaluationId String?
  evaluation  Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime? @updatedAt

  @@index([studentId])
  @@index([category])
  @@index([isImportant])
  @@index([evaluationId])
  @@schema("profesorapp")
}

model Reminder {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String?
  group       Group?    @relation(fields: [groupId], references: [id], onDelete: SetNull)
  studentId   String?
  student     Student?  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title       String
  message     String?
  category    String?   // ACADEMIC | PERSONAL | ADMINISTRATIVE | OTHER
  priority    String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([groupId])
  @@index([studentId])
  @@index([category])
  @@index([priority])
  @@index([dueDate])
  @@index([completed])
  @@schema("profesorapp")
}

// ============================================================
// FASE 0: Jerarquía académica e integración ITACA
// ============================================================

model AcademicYear {
  id          String       @id @default(cuid())
  itacaId     String?
  name        String       // ej: "2025-2026"
  startDate   DateTime?
  endDate     DateTime?
  status      String       @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  groups      Group[]
  enrollments Enrollment[]
  evaluations Evaluation[]
  studentContentEnrollments StudentContentEnrollment[]
  qualifications Qualification[]
  targetGrades  TargetGrade[]
  itacaConfig   ItacaConfig?
  academicYearData AcademicYearData?
  acImprentas   ACImprenta[]
  exigibles     Exigible[]

  @@unique([itacaId])
  @@index([status])
  @@schema("profesorapp")
}

model Education {
  id          String       @id @default(cuid())
  itacaId     String?
  code        String?    // código ITACA de la enseñanza
  name        String     // ej: "ESO", "Bachillerato", "Grado Medio"
  type        String     @default("OTHER") // ESO | BACHILLERATO | FP | OTHER
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  groups      Group[]
  courses     Course[]
  enrollments Enrollment[]
  teachingContents TeachingContent[]
  evaluations Evaluation[]

  @@unique([itacaId])
  @@index([type])
  @@schema("profesorapp")
}

model Course {
  id          String       @id @default(cuid())
  itacaId     String?
  educationId String
  education   Education  @relation(fields: [educationId], references: [id], onDelete: Cascade)
  code        String?    // código ITACA del curso
  name        String     // ej: "1º", "2º", "3º"
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  groups      Group[]
  enrollments Enrollment[]
  teachingContents TeachingContent[]

  @@unique([itacaId])
  @@index([educationId])
  @@schema("profesorapp")
}

model ItacaMapping {
  id          String   @id @default(cuid())
  entityType  String   // STUDENT | GROUP | EDUCATION | COURSE | CONTENT | EVALUATION
  internalId  String   // ID interno de nuestra app
  itacaId     String   // ID de ITACA
  itacaCode   String?  // código de ITACA (si aplica)
  metadata    Json?    // datos adicionales de ITACA
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([entityType, internalId])
  @@unique([entityType, itacaId])
  @@index([entityType])
  @@index([internalId])
  @@index([itacaId])
  @@schema("profesorapp")
}

// ============================================================
// FASE 1: Matrícula de alumnos
// ============================================================

model Enrollment {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  educationId     String?
  education       Education?  @relation(fields: [educationId], references: [id], onDelete: SetNull)
  courseId         String?
  course          Course?     @relation(fields: [courseId], references: [id], onDelete: SetNull)
  groupId         String
  group           Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  startDate       DateTime?
  endDate         DateTime?
  status          String      @default("ACTIVE") // ACTIVE | INACTIVE | TRANSFERRED
  itacaId         String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([groupId])
  @@index([itacaId])
  @@schema("profesorapp")
}

// ============================================================
// FASE 2: Contenidos y Evaluaciones
// ============================================================

model TeachingContent {
  id          String     @id @default(cuid())
  itacaId     String?
  code        String?    // código ITACA del contenido (ej: "MAT", "LEN")
  name        String     // ej: "Matemáticas", "Lengua", "Módulo 1"
  description String?
  subjectArea String?
  educationId String
  education   Education  @relation(fields: [educationId], references: [id], onDelete: Cascade)
  courseId     String?
  course      Course?    @relation(fields: [courseId], references: [id], onDelete: SetNull)
  type        String     @default("SUBJECT") // SUBJECT | MODULE | OTHER
  driveLink   String?    // enlace compartido de Google Drive / OneDrive / etc.
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  enrollments StudentContentEnrollment[]
  activities  Activity[]
  grades      Grade[]
  gradeObservations GradeObservation[]
  qualifications Qualification[]
  targetGrades  TargetGrade[]
  absences     Absence[]
  exigibles    Exigible[]

  @@unique([itacaId])
  @@index([educationId])
  @@index([courseId])
  @@index([type])
  @@schema("profesorapp")
}

model StudentContentEnrollment {
  id              String          @id @default(cuid())
  studentId       String
  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId       String
  content         TeachingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear    @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  status          String          @default("ACTIVE") // ACTIVE | INACTIVE | EXEMPT | VALIDATED
  itacaId         String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@unique([studentId, contentId, academicYearId])
  @@index([studentId])
  @@index([contentId])
  @@index([academicYearId])
  @@index([itacaId])
  @@schema("profesorapp")
}

model Evaluation {
  id              String     @id @default(cuid())
  itacaId         String?
  code            String?    // código ITACA de la evaluación
  name            String     // ej: "1ª Evaluación", "2ª Evaluación", "Final"
  type            String     @default("ORDINARY") // ORDINARY | EXTRAORDINARY | FINAL | PARTIAL | OTHER
  startDate       DateTime?
  endDate         DateTime?
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  educationId     String?
  education       Education?  @relation(fields: [educationId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  activities      Activity[]
  grades          Grade[]
  evaluationObservations EvaluationObservation[]
  gradeObservations GradeObservation[]
  qualifications Qualification[]
  absences        Absence[]
  studentNotes    StudentNote[]
  exigibles       Exigible[]

  @@unique([itacaId])
  @@index([academicYearId])
  @@index([educationId])
  @@index([type])
  @@index([startDate])
  @@index([endDate])
  @@index([createdAt])
  @@schema("profesorapp")
}

model Activity {
  id            String     @id @default(cuid())
  name          String
  description   String?
  date          DateTime?
  contentId     String?
  content       TeachingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  evaluationId  String
  evaluation    Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  weight        Float      @default(1) // peso para el cálculo de la media
  maxScore      Float      @default(10)
  type          String     @default("EXAM") // EXAM | WORK | NOTEBOOK | RUBRIC | OTHER
  isExtra       Boolean    @default(false)
  order         Int        @default(1)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  grades        Grade[]
  rubric        Rubric?

  @@index([contentId])
  @@index([evaluationId])
  @@index([order])
  @@index([type])
  @@index([isExtra])
  @@index([createdAt])
  @@schema("profesorapp")
}

// ============================================================
// FASE 2: Observaciones
// ============================================================

model GradeObservation {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId    String?
  content      TeachingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  evaluationId String?
  evaluation   Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  gradeId      String?
  grade        Grade?   @relation(fields: [gradeId], references: [id], onDelete: SetNull)
  text         String
  authorId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([studentId])
  @@index([contentId])
  @@index([evaluationId])
  @@index([gradeId])
  @@schema("profesorapp")
}

model EvaluationObservation {
  id           String   @id @default(cuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  evaluationId String
  evaluation   Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  text         String
  language     String?  // ES | VA (para bilingüismo)
  authorId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([studentId, evaluationId])
  @@index([studentId])
  @@index([evaluationId])
  @@schema("profesorapp")
}

// ============================================================
// FASE 3: Calificaciones y Objetivos
// ============================================================

model Qualification {
  id              String     @id @default(cuid())
  itacaId         String?
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId       String?
  content         TeachingContent? @relation(fields: [contentId], references: [id], onDelete: SetNull)
  evaluationId    String
  evaluation      Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  numericValue    Float?     // nota numérica final de la materia
  qualitativeValue String?   // valor cualitativo
  rawValue        Float?     // valor sin procesar
  status          String     @default("ACTIVE") // ACTIVE | REPEATED | EXEMPT | PASSED_PREVIOUSLY | OTHER
  source          String     @default("CALCULATED") // CALCULATED | MANUAL | IMPORTED
  isRecovery      Boolean    @default(false)
  recoveryDate    DateTime?
  finalDate       DateTime?  // fecha de calificación final
  itacaSyncDate   DateTime?  // fecha de sincronización con ITACA
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([studentId, contentId, evaluationId])
  @@index([studentId])
  @@index([contentId])
  @@index([evaluationId])
  @@index([academicYearId])
  @@index([status])
  @@index([isRecovery])
  @@index([numericValue])
  @@index([createdAt])
  @@schema("profesorapp")
}

model TargetGrade {
  id              String     @id @default(cuid())
  studentId       String
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId       String
  content         TeachingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  academicYearId  String
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  targetScore     Float?     // nota objetivo
  targetQualitative String?  // valor cualitativo objetivo
  itacaId         String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@unique([studentId, contentId, academicYearId])
  @@index([studentId])
  @@index([contentId])
  @@index([academicYearId])
  @@index([itacaId])
  @@schema("profesorapp")
}

// ============================================================
// FASE 4: Permisos (AppAccess)
// ============================================================

model AppAccess {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId     String
  group       Group      @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role        String     @default("TEACHER") // TEACHER | COORDINATOR | ADMIN | VIEWER
  permissions Json?      // permisos específicos (JSON)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
  @@index([role])
  @@schema("profesorapp")
}

// ============================================================
// FASE 5: Integración ITACA
// ============================================================

model ItacaConfig {
  id              String   @id @default(cuid())
  academicYearId  String   @unique
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  itacaUrl        String   // URL del servidor ITACA
  apiKey          String?  // API key para autenticación
  schoolCode      String?  // código del centro
  schoolName      String?  // nombre del centro
  syncEnabled     Boolean  @default(true)
  autoSync        Boolean  @default(false)
  syncInterval    Int      @default(60) // minutos entre sincronizaciones
  lastSyncAt      DateTime?
  lastSyncStatus  String?  // SUCCESS | PARTIAL | FAILED
  config          Json?    // configuración adicional
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  pendingSyncs    ItacaPendingSync[]
  importLogs      ItacaImportLog[]
  exportLogs      ItacaExportLog[]
  conflictResolutions ItacaConflictResolution[]
  auditLogs       ItacaAuditLog[]

  @@index([academicYearId])
  @@index([lastSyncAt])
  @@schema("profesorapp")
}

model ItacaPendingSync {
  id              String     @id @default(cuid())
  configId        String
  config          ItacaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  entityType      String     // STUDENT | GRADE | QUALIFICATION | TEACHING_CONTENT | ENROLLMENT
  entityId        String
  operation       String     // CREATE | UPDATE | DELETE
  status          String     @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  payload         Json?      // datos a sincronizar
  response        Json?      // respuesta de ITACA
  errorMessage    String?
  retryCount      Int        @default(0)
  maxRetries      Int        @default(3)
  nextRetryAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([configId])
  @@index([entityType, entityId])
  @@index([status])
  @@index([nextRetryAt])
  @@schema("profesorapp")
}

model ItacaImportLog {
  id              String     @id @default(cuid())
  configId        String
  config          ItacaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  importType      String     // FULL | INCREMENTAL | STUDENTS | GRADES
  status          String     @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | FAILED
  recordsTotal    Int        @default(0)
  recordsCreated  Int        @default(0)
  recordsUpdated  Int        @default(0)
  recordsFailed   Int        @default(0)
  conflicts       Int        @default(0)
  errors          Json?      // detalles de errores
  startedAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([configId])
  @@index([importType])
  @@index([status])
  @@index([startedAt])
  @@schema("profesorapp")
}

model ItacaExportLog {
  id              String     @id @default(cuid())
  configId        String
  config          ItacaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  exportType      String     // FULL | INCREMENTAL | GRADES | QUALIFICATIONS
  status          String     @default("RUNNING") // RUNNING | COMPLETED | PARTIAL | FAILED
  recordsTotal    Int        @default(0)
  recordsExported Int        @default(0)
  recordsFailed   Int        @default(0)
  errors          Json?      // detalles de errores
  xmlContent      String?    // contenido XML generado
  startedAt       DateTime   @default(now())
  completedAt     DateTime?

  @@index([configId])
  @@index([exportType])
  @@index([status])
  @@index([startedAt])
  @@schema("profesorapp")
}

model ItacaConflictResolution {
  id              String     @id @default(cuid())
  configId        String
  config          ItacaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  entityType      String     // STUDEN | GRADE | QUALIFICATION
  entityId        String
  localData       Json       // datos locales
  remoteData      Json       // datos remotos de ITACA
  resolution      String     @default("LOCAL_WINS") // LOCAL_WINS | REMOTE_WINS | MERGED | MANUAL
  mergedData      Json?      // datos fusionados (si resolution = MERGED)
  resolvedAt      DateTime?
  resolvedBy      String?    // userId del que resolvió
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([configId])
  @@index([entityType, entityId])
  @@index([resolution])
  @@index([resolvedAt])
  @@schema("profesorapp")
}

model ItacaAuditLog {
  id              String     @id @default(cuid())
  configId        String
  config          ItacaConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  action          String     // IMPORT | EXPORT | SYNC | CONFLICT_RESOLUTION
  entityType      String?
  entityId        String?
  userId          String?
  details         Json?      // detalles de la acción
  ipAddress       String?
  createdAt       DateTime   @default(now())

  @@index([configId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("profesorapp")
}

// ============================================================
// FASE 6: AuditLog y UserAppAccess
// ============================================================

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  groupId     String?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  action      String   // CREATE | UPDATE | DELETE | LOGIN | LOGOUT | IMPORT | EXPORT
  entityType  String   // STUDENT | GRADE | ASSESSMENT | TRIMESTER | GROUP | USER | OTHER
  entityId    String?
  oldData     Json?    // datos antes del cambio
  newData     Json?    // datos después del cambio
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([groupId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@schema("profesorapp")
}

model UserAppAccess {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId])
  @@index([userId])
  @@index([isActive])
  @@index([lastLoginAt])
  @@schema("profesorapp")
}

// ============================================================
// FASE 7: SchoolData (datos del centro)
// ============================================================

model SchoolData {
  id              String   @id @default(cuid())
  name            String   // nombre del centro
  code            String?  // código del centro
  address         String?
  city            String?
  province        String?
  postalCode      String?
  phone           String?
  email           String?
  website         String?
  director        String?
  directorDni     String?
  communityCode   String?  // código de comunidad autónoma
  educationType   String?  // ESO | BACHILLERATO | FP | MIXED
  config          Json?    // configuración adicional del centro
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  academicYears   AcademicYearData[]

  @@index([name])
  @@index([code])
  @@schema("profesorapp")
}

model AcademicYearData {
  id              String     @id @default(cuid())
  schoolDataId    String
  schoolData      SchoolData @relation(fields: [schoolDataId], references: [id], onDelete: Cascade)
  academicYearId  String     @unique
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  calendar        Json?      // calendario escolar
  schedule        Json?      // horario general
  rules           Json?      // normas de evaluación
  keyDates        Json?      // fechas clave (start, end, eval periods)
  config          Json?      // configuración adicional del año
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([schoolDataId])
  @@index([academicYearId])
  @@schema("profesorapp")
}

// ============================================================
// FASE 9: Tablas auxiliares
// ============================================================

model ACImprenta {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  documentType String  // DNI | NIE | PASSPORT | OTHER
  documentNumber String
  fullName    String
  birthDate   DateTime?
  gender      String?  // M | F | OTHER
  nationality String?
  address     String?
  city        String?
  postalCode  String?
  phone       String?
  email       String?
  parentName  String?
  parentPhone String?
  parentEmail String?
  config      Json?    // datos adicionales del impreso
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, academicYearId])
  @@index([studentId])
  @@index([academicYearId])
  @@index([documentNumber])
  @@schema("profesorapp")
}

model Exigible {
  id          String   @id @default(cuid())
  studentId   String
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  contentId   String
  content     TeachingContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  evaluationId String?
  evaluation  Evaluation? @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  isRequired  Boolean  @default(true)
  isCompleted Boolean  @default(false)
  completedAt DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, contentId, academicYearId])
  @@index([studentId])
  @@index([contentId])
  @@index([academicYearId])
  @@index([evaluationId])
  @@index([isCompleted])
  @@schema("profesorapp")
}